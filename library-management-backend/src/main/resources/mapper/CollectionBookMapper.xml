<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.library.management.module.collectionbook.mapper.CollectionBookMapper">

    <select id="selectPageByProblemAndBranch"
            resultType="com.library.management.module.collectionbook.entity.CollectionBook">
        SELECT
            barcode,
            book_name,
            author,
            isbn,
            publisher,
            publish_year,
            branch_library,
            call_number,
            price,
            batch,
            is_stored,
            library_location,
            shelf_location,
            duplicate_flag,
            is_problem,
            problem_type,
            problem_reason,
            created_by,
            create_time,
            updated_by,
            update_time
        FROM collection_books FORCE INDEX (idx_cb_problem_branch_create_barcode)
        WHERE is_problem = #{isProblem}
          AND branch_library = #{branchLibrary}
        ORDER BY create_time DESC, barcode DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countByProblemAndBranch" resultType="long">
        SELECT COUNT(*)
        FROM collection_books FORCE INDEX (idx_cb_problem_branch_create_barcode)
        WHERE is_problem = #{isProblem}
          AND branch_library = #{branchLibrary}
    </select>

    <sql id="collectionBookConditionWhere">
        <where>
            <if test="request.barcode != null and request.barcode != ''">
                AND barcode = #{request.barcode}
            </if>
            <if test="request.bookName != null and request.bookName != ''">
                AND book_name LIKE CONCAT('%', #{request.bookName}, '%')
            </if>
            <if test="request.author != null and request.author != ''">
                AND author LIKE CONCAT('%', #{request.author}, '%')
            </if>
            <if test="request.isbn != null and request.isbn != ''">
                AND isbn = #{request.isbn}
            </if>
            <if test="request.publisher != null and request.publisher != ''">
                AND publisher LIKE CONCAT('%', #{request.publisher}, '%')
            </if>
            <if test="request.publishYear != null and request.publishYear != ''">
                AND publish_year = #{request.publishYear}
            </if>
            <if test="request.branchLibrary != null and request.branchLibrary != ''">
                AND branch_library = #{request.branchLibrary}
            </if>
            <if test="request.callNumber != null and request.callNumber != ''">
                AND call_number LIKE CONCAT('%', #{request.callNumber}, '%')
            </if>
            <if test="request.batch != null and request.batch != ''">
                AND batch = #{request.batch}
            </if>
            <if test="request.isStored != null">
                AND is_stored = #{request.isStored}
            </if>
            <if test="request.libraryLocation != null and request.libraryLocation != ''">
                AND library_location LIKE CONCAT('%', #{request.libraryLocation}, '%')
            </if>
            <if test="request.duplicateFlag != null">
                AND duplicate_flag = #{request.duplicateFlag}
            </if>
            <if test="request.isProblem != null">
                AND is_problem = #{request.isProblem}
            </if>
            <if test="request.problemType != null and request.problemType != ''">
                AND problem_type LIKE CONCAT('%', #{request.problemType}, '%')
            </if>
        </where>
    </sql>

    <sql id="detectionScanColumns">
        barcode,
        book_name,
        author,
        isbn,
        publisher,
        publish_year,
        call_number,
        create_time
    </sql>

    <select id="countCollectionBooksByConditions" resultType="long">
        SELECT COUNT(*)
        FROM collection_books FORCE INDEX (idx_cb_problem_create_barcode)
        <include refid="collectionBookConditionWhere" />
    </select>

    <select id="selectCollectionBooksBatchByConditions"
            resultType="com.library.management.module.collectionbook.entity.CollectionBook">
        SELECT
        <include refid="detectionScanColumns" />
        FROM collection_books FORCE INDEX (idx_cb_problem_branch_create_barcode)
        <include refid="collectionBookConditionWhere" />
        ORDER BY create_time DESC, barcode DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="selectNextBatchByProblem"
            resultType="com.library.management.module.collectionbook.entity.CollectionBook">
        SELECT
        <include refid="detectionScanColumns" />
        FROM collection_books
        WHERE is_problem = #{isProblem}
        <if test="lastCreateTime != null and lastBarcode != null and lastBarcode != ''">
            AND (
                create_time &lt; #{lastCreateTime}
                OR (create_time = #{lastCreateTime} AND barcode &lt; #{lastBarcode})
            )
        </if>
        ORDER BY create_time DESC, barcode DESC
        LIMIT #{pageSize}
    </select>

    <select id="selectNextBatchByProblemAndBranch"
            resultType="com.library.management.module.collectionbook.entity.CollectionBook">
        SELECT
        <include refid="detectionScanColumns" />
        FROM collection_books
        WHERE is_problem = #{isProblem}
          AND branch_library = #{branchLibrary}
        <if test="lastCreateTime != null and lastBarcode != null and lastBarcode != ''">
            AND (
                create_time &lt; #{lastCreateTime}
                OR (create_time = #{lastCreateTime} AND barcode &lt; #{lastBarcode})
            )
        </if>
        ORDER BY create_time DESC, barcode DESC
        LIMIT #{pageSize}
    </select>

    <select id="selectCollectionBooksByConditions"
            resultType="com.library.management.module.collectionbook.entity.CollectionBook">
        SELECT *
        FROM collection_books
        <include refid="collectionBookConditionWhere" />
        LIMIT 10000
    </select>

</mapper>
