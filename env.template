# 环境变量配置模板
# 复制此文件为 .env 并修改相应的值

# MySQL数据库配置
MYSQL_ROOT_PASSWORD=请修改为强密码
MYSQL_DATABASE=library_management
MYSQL_USER=library_user
MYSQL_PASSWORD=请修改为数据库用户密码

# JWT密钥（生产环境请务必修改，建议使用 openssl rand -base64 32 生成）
JWT_SECRET=请修改为至少32位的随机字符串

# JVM参数（可选，根据服务器配置调整）
# 示例：-Xms1024m -Xmx2048m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

